# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# 공개용 anon 키(또는 sb_publishable_ 로 시작하는 publishable 키)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 service_role 키 (회원가입·관리자 기능에 사용). NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 계정: 이 닉네임·비밀번호로 처음 로그인할 때 관리자 계정이 만들어집니다.
# 비밀번호는 공개 저장소에 올리지 말고 .env.local과 Vercel 환경 변수에만 넣으세요.
ADMIN_NICKNAME=root
ADMIN_PASSWORD=

# Google AI Studio에서 발급. 서버에서만 쓰이며 브라우저로 나가지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 선택: 내부용 로그인 주소의 도메인 (사용자에게 보이지 않음, 메일 발송 없음)
AUTH_EMAIL_DOMAIN=trip-together.local
# 선택: Nominatim 사용 정책상 연락처 이메일 (없어도 동작)
NOMINATIM_EMAIL=
