# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# 공개용 anon 키(또는 sb_publishable_ 로 시작하는 publishable 키). service_role 키는 넣지 마세요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio에서 발급. 서버에서만 쓰이며 브라우저로 나가지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 선택: Nominatim 사용 정책상 연락처 이메일 (없어도 동작)
NOMINATIM_EMAIL=
